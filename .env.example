# 開発用の環境変数の見本。これをコピーして .env を作る（.env はコミットしない）
#   cp .env.example .env
# SECRET_KEY は次のコマンドで作った値に置き換える
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
# （# や $ を含むと .env の読み込みで誤解されるため、英数字と - _ だけの値にする）
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# 接続先の DB（compose.yaml の MySQL）。形式：mysql://利用者:パスワード@ホスト:ポート/DB名
DATABASE_URL=mysql://budget:budget@127.0.0.1:3306/budget
